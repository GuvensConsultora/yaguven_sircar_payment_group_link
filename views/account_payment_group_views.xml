<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_group_form_inherit_sircar"
            model="ir.ui.view">
        <field name="name">account.payment.group.form.inherit.sircar</field>
        <field name="model">account.payment.group</field>
        <field name="inherit_id"
               ref="yaguven_payment_group.view_account_payment_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compute_sircar_retentions"
                        type="object"
                        string="Calcular retenciones SIRCAR"
                        class="btn-secondary"
                        invisible="state != 'draft' or partner_type != 'supplier'"
                        help="Lee las condiciones SIRCAR del proveedor y crea automáticamente las líneas de retención sobre las facturas imputadas. Respeta líneas ya cargadas y mínimos no imponibles del régimen."/>
            </xpath>
        </field>
    </record>
</odoo>
